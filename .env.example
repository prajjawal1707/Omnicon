# OmniCon AI - provider configuration
# Start in demo mode to test orchestration without API keys.
EXECUTION_MODE=local
MAX_PARALLEL_WORKERS=2

# Local Ollama (free after you have downloaded a model)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:latest

# Optional OpenAI-compatible provider (examples: Groq, OpenRouter,
# Gemini OpenAI-compatible endpoint, or your own compatible gateway).
# Configure a provider with:
# PROVIDER_<NAME>_BASE_URL=https://provider.example/v1
# PROVIDER_<NAME>_API_KEY=your-key
# PROVIDER_<NAME>_MODEL=model-name
# Example:
# PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_GROQ_API_KEY=
# PROVIDER_GROQ_MODEL=

# Optional Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Assign different providers to each role.
# Values: demo, ollama, anthropic, or the name of a PROVIDER_<NAME>_... group.
AGENT_ARCHITECT_PROVIDER=ollama
AGENT_DEVELOPER_PROVIDER=ollama
AGENT_DEBUGGER_PROVIDER=ollama
AGENT_REVIEWER_PROVIDER=ollama
